rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions: public read (parents check capacity), write open (PIN-gated at UI layer)
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    // Registrations: public create (parents register), read/update open (admin PIN-gated at UI)
    // Delete is forbidden — use status='cancelled' instead
    match /registrations/{regId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Notification logs: server-side only (Cloud Functions Admin SDK)
    match /notificationLogs/{logId} {
      allow read, write: if false;
    }
  }
}
